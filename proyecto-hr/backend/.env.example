# Copy this file to .env and fill in real values

MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/hrdb?retryWrites=true&w=majority
JWT_SECRET=replace_with_secure_secret_min_32_chars
PORT=3000

# Primary frontend origin allowed by CORS (e.g. https://app.example.com).
# Leave empty in development — localhost origins are added automatically.
FRONTEND_URL=

# Comma-separated list of additional frontend origins allowed by CORS
# (e.g. https://app.example.com,https://staging.example.com).
# Useful when multiple domains need access. Leave empty if FRONTEND_URL is enough.
FRONTEND_ORIGINS=

ALLOW_DEMO_SEED=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_COMPANY_NAME=
SEED_COMPANY_SLUG=
SEED_SCHOOL_NAME=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=performia
S3_PUBLIC_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=performia

# Secret token required to call automation endpoints (e.g. /automation/*).
# Generate a strong random string (32+ chars) and keep it private.
AUTOMATION_TOKEN=

SUPPORT_CACHE_TTL_MS=120000
SUPPORT_RATE_WINDOW_MS=60000
SUPPORT_RATE_MAX_REQUESTS=20
